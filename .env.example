PORT=5000
DB_URL='DB_URL'
NODE_ENV='production'

BCRYPT_SALT_ROUND=number


JWT_ACCESS_SECRET=string
JWT_ACCESS_EXPIRES=string

JWT_REFRESH_SECRET=string
JWT_REFRESH_EXPIRES=string

FRONTEND_URL_LOCAL=url
# FRONTEND_URL_LOCAL is optional — local dev only
FRONTEND_URL_PRODUCTION=url

CLOUDINARY_CLOUD_NAME=string
CLOUDINARY_API_KEY=string
CLOUDINARY_API_SECRET=string

# --- reminder module ---------------------------------------------------------
# Real values live only in .env (gitignored). Never commit the bot token or the
# chat id.
TELEGRAM_BOT_TOKEN=from_@BotFather
TELEGRAM_CHAT_ID=numeric_id_from_getUpdates
REMINDER_SECRET=run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REMINDER_TZ=Asia/Dhaka

# Optional. Vercel Cron can only send its own Authorization header, so set this
# ON VERCEL ONLY (Project → Settings → Environment Variables → CRON_SECRET) to
# whatever random string you like — e.g. the same generation command as above.
# Vercel then calls /api/v1/reminders/check with `Authorization: Bearer <value>`.
# Leave it unset locally; the controller falls back to x-reminder-secret.
CRON_SECRET=

# --- reminder fallback scheduler ---------------------------------------------
# Used only by scripts/setup-cronjob-org.js, which provisions three staggered
# cron-job.org jobs as a second trigger in case a Vercel Cron run is missed.
# Not read by the app at runtime.
#
# CRONJOB_API_KEY: cron-job.org Console -> Settings -> API keys
# APP_URL: the deployed base URL, no trailing slash. cron-job.org runs in the
# cloud and cannot reach localhost, so this must be the public URL.
CRONJOB_API_KEY=
APP_URL=https://your-app.vercel.app
